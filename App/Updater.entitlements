<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The updater is the only part of MarDock that may use the network, and it
  is sandboxed: outgoing connections, and nothing else (no files beyond its
  own container, no incoming connections, no hardened-runtime exceptions).
  scripts/security-audit.sh fails the build if this list ever grows.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
