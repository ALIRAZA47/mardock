# Editor settings for MarDock (https://editorconfig.org). There is no
# formatter or linter to run; this just keeps editors consistent.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{html,css,js,sh}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.plist]
indent_style = tab
